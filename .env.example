# Populated by `azd up` (from Bicep outputs) and/or for local dev.
# Never commit a real .env. All service access is via Managed Identity in Azure;
# locally you use `az login` (DefaultAzureCredential picks it up).

# --- Azure OpenAI (Foundry) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Azure AI Content Safety ---
CONTENT_SAFETY_ENDPOINT=

# --- Azure AI Language (PII) ---
LANGUAGE_ENDPOINT=

# --- Postgres (pgvector + LangGraph checkpointer) ---
# Host/db/user come from Bicep. Auth is Entra by default (no password here);
# a token-refreshing factory fetches DB tokens at runtime.
POSTGRES_HOST=
POSTGRES_DB=appdb
POSTGRES_USER=
POSTGRES_SSLMODE=require

# --- App ---
# Local dev bypass for Easy Auth; MUST be false in any deployed environment.
AUTH_DISABLED=false
